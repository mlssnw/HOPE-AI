# Copie para .env. Nunca envie .env ao GitHub.
# Em produção, use uma role de runtime dedicada com TLS verify-full.
DATABASE_URL=
# Opcional; somente Alembic/operação, nunca o processo web.
DATABASE_ADMIN_URL=
DATABASE_ECHO=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=900
APP_ENVIRONMENT=development
EMBEDDING_PROVIDER=local-hash
EMBEDDING_DIMENSIONS=1536
MEMORY_MIN_IMPORTANCE=0.45
MEMORY_DUPLICATE_SIMILARITY=0.92
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-6
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
OBSIDIAN_API_KEY=
OBSIDIAN_BASE_URL=http://127.0.0.1:27123
OBSIDIAN_VERIFY_TLS=true
REQUEST_TIMEOUT_SECONDS=25
MAX_PROMPT_CHARS=8000
MAX_HISTORY_MESSAGES=20
MAX_RAG_RESULTS=3
MAX_RAG_CHARS=6000
